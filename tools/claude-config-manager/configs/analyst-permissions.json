{
  "role": "analyst",
  "version": "1.0.0",
  "description": "Read-only access — no write/edit permissions; can read docs and reports",
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)"
    ],
    "deny": [
      "Write(**)",
      "Edit(**)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(npm *)",
      "Bash(python3 -c *)"
    ],
    "additionalDirectories": [
      "docs/",
      "reports/"
    ]
  }
}

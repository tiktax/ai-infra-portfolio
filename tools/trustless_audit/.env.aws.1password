# AWS credentials for WORM storage (S3 Object Lock)
# All values are 1Password references — no real credentials in this file
# Usage: op run --env-file=tools/trustless_audit/.env.aws.1password -- <command>

AWS_ACCESS_KEY_ID="op://AI Portfolio/aws-credentials/access_key_id"
AWS_SECRET_ACCESS_KEY="op://AI Portfolio/aws-credentials/secret_access_key"
AWS_DEFAULT_REGION="ap-northeast-1"

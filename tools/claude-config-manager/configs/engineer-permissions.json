{
  "role": "engineer",
  "version": "1.0.0",
  "description": "Full development access — write to src, tests, docs; blocked from destructive ops",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(python3 *)",
      "Write(src/**)",
      "Edit(src/**)",
      "Write(tests/**)",
      "Edit(tests/**)",
      "Write(docs/**)",
      "Edit(docs/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push *--force*)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(env)",
      "Bash(printenv)"
    ],
    "additionalDirectories": []
  }
}
